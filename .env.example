BOT_TOKEN=
ADMIN_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_JSON_MODE=true
POSTGRES_USER=botlooks
POSTGRES_PASSWORD=
POSTGRES_DB=botlooks
# Not interpolated by the app: docker compose overrides DATABASE_URL; for local runs put a literal URL with the real password here.
DATABASE_URL=postgresql+asyncpg://botlooks:${POSTGRES_PASSWORD}@postgres:5432/botlooks
START_CREDITS=3
LOG_LEVEL=INFO
